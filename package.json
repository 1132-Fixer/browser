{
  "name": "1132-fixer-browser-extension",
  "version": "1.2.7",
  "private": true,
  "description": "1132 Fixer browser extension workspace: one shared core, thin browser adapters, and independently packaged Chrome, Edge, Brave, and Firefox builds plus a BRAVIA TV guide client. Zoom-origin only, user-triggered, no remote code, no telemetry.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:chrome": "node tooling/build/build.js chrome --watch",
    "dev:edge": "node tooling/build/build.js edge --watch",
    "dev:brave": "node tooling/build/build.js brave --watch",
    "dev:firefox": "node tooling/build/build.js firefox --watch",
    "dev:bravia": "node tooling/build/build.js bravia --watch",
    "build": "node tooling/build/build.js --all",
    "build:chrome": "node tooling/build/build.js chrome",
    "build:edge": "node tooling/build/build.js edge",
    "build:brave": "node tooling/build/build.js brave",
    "build:firefox": "node tooling/build/build.js firefox",
    "build:bravia": "node tooling/build/build.js bravia",
    "package": "node tooling/packaging/package.js --all",
    "package:chrome": "node tooling/packaging/package.js chrome",
    "package:edge": "node tooling/packaging/package.js edge",
    "package:brave": "node tooling/packaging/package.js brave",
    "package:firefox": "node tooling/packaging/package.js firefox",
    "package:bravia": "node tooling/packaging/package.js bravia",
    "lint": "node tests/integration/validate-source.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node tests/integration/validate-dist.js",
    "test:e2e": "node tests/end-to-end/run-all.js",
    "test:e2e:popup": "node tests/end-to-end/popup.e2e.js",
    "test:e2e:report": "node tests/end-to-end/report.e2e.js",
    "test:e2e:install": "node tests/end-to-end/extension-install.e2e.js",
    "test:e2e:bravia": "node tests/end-to-end/bravia.e2e.js",
    "verify:manifests": "node tooling/packaging/verify-manifests.js",
    "verify:permissions": "node tooling/packaging/verify-permissions.js",
    "verify:packages": "node tooling/packaging/verify-packages.js",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run verify:manifests && npm run verify:permissions && npm run test:integration && npm run package && npm run verify:packages && npm run test:e2e",
    "version:print": "node tooling/release/bump-version.js --print",
    "bump": "node tooling/release/bump-version.js patch",
    "bump:minor": "node tooling/release/bump-version.js minor",
    "bump:major": "node tooling/release/bump-version.js major",
    "assets": "node tooling/store-assets/capture-screenshots.js && node tooling/store-assets/letterbox-screenshots.js && node tooling/store-assets/make-promo.js && node tooling/store-assets/make-promo.js 1400 560 && node tooling/store-assets/make-store-icon.js && npm run assets:verify",
    "assets:details": "node tooling/store-assets/capture-extension-details.js",
    "assets:verify": "node tooling/store-assets/verify-store-assets.js",
    "listing:verify": "node tooling/store-assets/verify-store-listing.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "web-ext": "10.6.0"
  }
}
